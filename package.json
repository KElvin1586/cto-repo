{
  "name": "qr-studio",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "description": "QR Studio — a private, offline-first QR code generator with a functional Free/Premium plan. URL and Text codes free; all 10 types, logos, advanced styles, SVG/PDF export, history, templates and batch generation in Premium. Everything runs locally in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "bun run serve.ts",
    "publish": "bash ./publish.sh",
    "format": "prettier --write ."
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/jspdf": "^2.0.0",
    "@types/node": "^25.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.0.1",
    "vite-tsconfig-paths": "^6.0.5"
  }
}
